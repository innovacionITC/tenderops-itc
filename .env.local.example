# =============================================================================
# API .NET (tenderops-api) — el front es un BFF desde la Fase 7
# =============================================================================
TENDEROPS_API_URL=http://localhost:5106

# Microsoft Entra ID — SSO (authorization code flow + PKCE hecho por el BFF).
# Opcionales: sin ellos el botón "Iniciar con Microsoft" redirige con error.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# =============================================================================
# Supabase — no las usa el frontend en runtime
# =============================================================================
# El Banco de Perfiles persiste vía TENDEROPS_API_URL (el API .NET ya tiene
# DATABASE_URL y SUPABASE_SERVICE_ROLE_KEY). No copie esas keys a Next.js.
# DATABASE_URL aquí solo sirve a drizzle-kit (db:pull / db:studio).
NEXT_PUBLIC_SUPABASE_URL=https://jajhwjkwkeajpdkvfwza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

# =============================================================================
# Pendiente para fases futuras (no usadas todavía por esta base)
# =============================================================================
# Microsoft Entra ID (Dynamics / Graph)
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Dynamics 365 / Dataverse — se configuran por organización en /admin/credenciales
# (la API los lee de api_credentials con fallback a estas variables de entorno).
# DYNAMICS_URL=
# DYNAMICS_TENANT_ID=
# DYNAMICS_CLIENT_ID=
# DYNAMICS_CLIENT_SECRET=
# DYNAMICS_APP_ID=
# DYNAMICS_OPPORTUNITY_DEFAULTS=

# SharePoint vía Microsoft Graph
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SITE_ID=
# GRAPH_DRIVE_ID=
# GRAPH_ROOT_FOLDER=Procesos

# SECOP II (Socrata · datos.gov.co)
# SECOP_APP_TOKEN=
# SECOP_APP_TOKEN_SECRET=
# SECOP_API_KEY_ID=
# SECOP_API_KEY_SECRET=

# Microsoft Copilot Studio (Direct Line 3.0)
# NEXT_PUBLIC_DIRECTLINE_BASE_URL=https://directline.botframework.com
