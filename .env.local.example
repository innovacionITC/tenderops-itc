# =============================================================================
# API .NET (tenderops-api) — el front es un BFF desde la Fase 7
# =============================================================================
TENDEROPS_API_URL=http://localhost:5106

# Microsoft Entra ID — SSO (authorization code flow + PKCE hecho por el BFF).
# Opcionales: sin ellos el botón "Iniciar con Microsoft" redirige con error.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# =============================================================================
# Supabase — públicas (expuestas al navegador)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://jajhwjkwkeajpdkvfwza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Supabase — privadas (solo servidor, nunca exponer al cliente)
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=

# Connection string directo de Postgres (Supabase Dashboard → Project Settings →
# Database → Connection string). Usado por Drizzle (drizzle-kit pull / cliente
# de queries). Esta conexión NO respeta RLS: la autorización se hace en la capa
# de aplicación (ver src/lib/auth/session.ts).
DATABASE_URL=

# =============================================================================
# Pendiente para fases futuras (no usadas todavía por esta base)
# =============================================================================
# Microsoft Entra ID (Dynamics / Graph)
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Dynamics 365 / Dataverse
# DATAVERSE_URL=
# DYNAMICS_CLIENT_ID=
# DYNAMICS_CLIENT_SECRET=

# SharePoint vía Microsoft Graph
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SITE_ID=
# GRAPH_DRIVE_ID=
# GRAPH_ROOT_FOLDER=Procesos

# SECOP II (Socrata · datos.gov.co)
# SECOP_APP_TOKEN=
# SECOP_APP_TOKEN_SECRET=
# SECOP_API_KEY_ID=
# SECOP_API_KEY_SECRET=

# Microsoft Copilot Studio (Direct Line 3.0)
# NEXT_PUBLIC_DIRECTLINE_BASE_URL=https://directline.botframework.com
